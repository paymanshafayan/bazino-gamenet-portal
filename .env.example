# GEMINI_API_KEY: Required for Gemini AI API calls.
# The hosting environment injects this at runtime from user secrets.
# Users configure this via the Secrets panel of their hosting platform.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this app is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- پرداخت (تسک ۱۳) ---
# درگاه آنلاین PayTR به‌صورت پیش‌فرض خاموش است؛ پرداخت‌ها با کیف پول / در محل انجام می‌شود.
# برای فعال‌سازی دوباره: PAYMENT_ONLINE_ENABLED=1 + PAYTR_MERCHANT_ID/KEY/SALT (docs/payments/PAYTR.md)
# PAYMENT_ONLINE_ENABLED=1

# --- تلگرام: پورتال (B1) ---
# آدرس داخلی سرویس Gateway + همان اعتبارهایی که روی Gateway ست شده‌اند.
# بدون این‌ها، مسیرهای /api/manus/telegram/* و تب تلگرام استودیو از کار می‌افتند (fail-closed).
TG_GATEWAY_URL="https://tg-gateway.up.railway.app"
TG_GATEWAY_BEARER="CHANGE_ME_32_PLUS_RANDOM_CHARS"
TG_GATEWAY_HMAC_SECRET="CHANGE_ME_32_PLUS_RANDOM_CHARS"

# --- تلگرام: Gateway (B2) — روی سرویس telegram-gateway در Railway ---
# TG_USE_FAKE=true فقط برای dev/تست است؛ در پروداکشن حتماً false + سشن واقعی.
GATEWAY_BEARER="CHANGE_ME_32_PLUS_RANDOM_CHARS"
GATEWAY_HMAC_SECRET="CHANGE_ME_32_PLUS_RANDOM_CHARS"
TG_API_ID=""
TG_API_HASH=""
TG_SESSION_STRING=""
TG_USE_FAKE="false"
SEND_MIN_INTERVAL_SECONDS="60"
SEND_MAX_PER_HOUR="30"
DB_PATH="/data/tg-gateway.sqlite"
