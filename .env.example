# GEMINI_API_KEY: Required for Gemini AI API calls.
# The hosting environment injects this at runtime from user secrets.
# Users configure this via the Secrets panel of their hosting platform.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this app is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- پرداخت (تسک ۱۳) ---
# درگاه آنلاین PayTR به‌صورت پیش‌فرض خاموش است؛ پرداخت‌ها با کیف پول / در محل انجام می‌شود.
# برای فعال‌سازی دوباره: PAYMENT_ONLINE_ENABLED=1 + PAYTR_MERCHANT_ID/KEY/SALT (docs/payments/PAYTR.md)
# PAYMENT_ONLINE_ENABLED=1
