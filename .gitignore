node_modules/
build/
dist/
coverage/
.DS_Store
*.log
.env*
!.env.example

# Real database files / local install state — must never be committed
install-config.json
bazino.sqlite3
bazino.sqlite3-*
database.json

# Runtime-installed theme packages (installed via admin panel ZIP upload) — only at repo root
/themes/

# Deliverable/export archives and transient root-level reports/logs — never commit into the repo
*.zip
/logs_*.zip
/GTmetrix-report*.pdf
/bazino.mp4

# AI assistant skill folders (installed per-machine via CLI, not part of the project)
.claude/
.cursor/
.gemini/
.windsurf/
.claude-plugin/

# Runtime-uploaded mobile app binaries
public/downloads/*.apk
public/downloads/*.aab
public/downloads/*.ipa
!public/downloads/.gitkeep

# Test-run reports (regenerated by `npm test`)
tests/reports/

# Runtime-generated optimized mobile images (auto-made by admin panel via sharp)
public/images/mobile/generated/
tmp-shots/
