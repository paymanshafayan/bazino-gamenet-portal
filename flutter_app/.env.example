# GEMINI_API_KEY: Required for Gemini AI API calls.
# The hosting environment injects this at runtime from user secrets.
# Users configure this via the Secrets panel of their hosting platform.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# The hosting environment injects this at runtime with the public service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
