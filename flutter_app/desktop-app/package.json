{
  "name": "bazino-pro-desktop",
  "version": "1.0.0",
  "description": "نسخه‌ی دسکتاپ مستقل نرم‌افزار مدیریت گیم‌نت BAZINO PRO — بک‌اند Node.js واقعی + دیتابیس SQLite محلی، همه داخل یک اپ نصبی، با قابلیت همگام‌سازی با سرور سایت.",
  "main": "main.js",
  "author": "BAZINO PRO",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "prepare-server-bundle": "node scripts/prepare-server-bundle.js",
    "start": "npm run prepare-server-bundle && electron .",
    "dist": "npm run prepare-server-bundle && electron-builder",
    "dist:win": "npm run prepare-server-bundle && electron-builder --win",
    "dist:mac": "npm run prepare-server-bundle && electron-builder --mac",
    "dist:linux": "npm run prepare-server-bundle && electron-builder --linux"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.bazinopro.desktop",
    "productName": "BAZINO PRO",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "icons/**/*"
    ],
    "extraResources": [
      {
        "from": "server-bundle",
        "to": "server"
      }
    ],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "icons/icon.ico"
    },
    "mac": {
      "target": ["dmg"],
      "icon": "icons/icon.icns",
      "category": "public.app-category.business"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "icons/icon.png",
      "category": "Office"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
