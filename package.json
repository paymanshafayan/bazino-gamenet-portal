{
  "name": "bazino-pro",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && (cd 'Management App/Bazino' && npm install && npm run build) && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "audit:theme": "tsx scripts/audit-theme-package.mts",
    "test:theme-performance": "tsx scripts/test-theme-performance.mts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.3.0",
    "compression": "^1.8.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "fflate": "^0.8.3",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.546.0",
    "mongodb": "^6.9.0",
    "motion": "^12.42.2",
    "mssql": "^11.0.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sharp": "^0.35.3",
    "vite": "^6.2.3",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@csstools/postcss-oklab-function": "^4.0.7",
    "@preact/preset-vite": "^2.10.6",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.11",
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.14.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-legacy": "^6.1.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "postcss": "^8.4.49",
    "preact": "^10.29.8",
    "tailwindcss": "^4.1.14",
    "terser": "^5.49.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "description": "Bazino Pro — Gaming net club platform (reservation, cafe, shop, tournaments, loyalty, themes)"
}
