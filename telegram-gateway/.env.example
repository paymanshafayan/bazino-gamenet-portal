# Telegram Gateway env — set on the Railway service, NEVER in git/chat.
# Portal side needs: TG_GATEWAY_URL (internal service URL), TG_GATEWAY_BEARER (same value),
# TG_GATEWAY_HMAC_SECRET (same value).

PORT=8000
# Shared secrets with the portal (random 32+ bytes hex):
GATEWAY_BEARER=change-me-bearer
GATEWAY_HMAC_SECRET=change-me-hmac-secret

# Telegram API credentials from https://my.telegram.org (owner only):
TG_API_ID=
TG_API_HASH=
# Session string from the owner ceremony (B5 runbook in README). Empty = send/dialogs refuse with 503.
TG_SESSION_STRING=

# Safety rails (defaults are conservative):
SEND_MIN_INTERVAL_SECONDS=60
SEND_MAX_PER_HOUR=30
DB_PATH=/data/tg-gateway.sqlite

# NEVER true in production: in-memory fake adapter for local dev/tests only.
TG_USE_FAKE=false
